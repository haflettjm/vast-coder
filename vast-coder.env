# Desired state for the vast.ai coding-model box.
# Every bin/ script reads this file. Edit here, then run bin/up.

# Instance identity. bin/up will not create a second instance with this label.
LABEL="${LABEL:-vast-coder}"

# 1Password reference for the vast.ai API key.
VAST_KEY_REF="op://Personal/Vast.ai/credential"

# Offer search (vastai search offers syntax), cheapest match wins.
OFFER_QUERY="gpu_name=RTX_3090 num_gpus=2 verified=true reliability>0.98 inet_down>500 disk_space>=56 direct_port_count>=1 rentable=true cuda_vers>=12.8"
DISK_GB=56
MAX_HOURLY_COST=0.35138499542366775
# Empty means any country. For North America use US,CA; US only: US.
COUNTRIES=""

# Serving engine: llamacpp or vllm. llamacpp is the supported engine. vLLM loads this GGUF
# but reads prompts about 7 times slower (see docs/operations.md), so it is experimental.
# An exported ENGINE overrides this file.
ENGINE="${ENGINE:-llamacpp}"

# Inference server image. Official llama.cpp CUDA build.
IMAGE="ghcr.io/ggml-org/llama.cpp:server-cuda"
TEMPLATE_NAME="vast-coder-gguf-ssh"

# Model (GGUF on Hugging Face).
HF_REPO="DavidAU/Qwen3.8-27B-TURBO-Fable-Cold-Fusion-735-882-Heretic-Uncensored-NEO-CODER-MAX-MTP-GGUF"
HF_FILE="Qwen3.8-27B-TurboFCFusion-735-882-Here-Uncen-NEO-CODER-MAX-MTP-Q5_K_S.gguf"
MODEL_ALIAS="qwen3.8-coder"

# Server settings. Sampling follows the model card's "precise coding" preset.
CTX_SIZE=262144
SPLIT_MODE=tensor
# K/V cache precision: f16 or q8_0. q8_0 roughly halves cache memory.
KV_CACHE_TYPE=q8_0
SPEC_TYPE=draft-mtp
DRAFT_MAX=2
PARALLEL=4
# Logical and physical batch size (-b and -ub). 2048 was benchmarked for cold prefill.
LLAMA_BATCH=2048
REMOTE_PORT=8080
LOCAL_PORT=8000
HEALTH_TIMEOUT=5
HEALTH_COOLDOWN=120
HEALTH_FAILURES=3
DISCOVERY_TIMEOUT=15
CACHE_MAX_AGE=86400
SAMPLING="--temp 0.6 --top-p 0.95 --top-k 20 --min-p 0"

# vLLM engine (used only when ENGINE=vllm). GGUF support in vLLM is experimental; the
# tokenizer and config come from the base model because the GGUF repo has neither.
VLLM_IMAGE="vllm/vllm-openai:v0.31.0"
VLLM_HF_FILE="Qwen3.8-27B-TurboFCFusion-735-882-Here-Uncen-NEO-CODER-MAX-MTP-Q5_K_S.gguf"
VLLM_BASE_MODEL="Qwen/Qwen3.8-27B"
VLLM_KV_DTYPE=fp8
VLLM_GPU_UTIL=0.92
# vllm-gguf-plugin commit with the Qwen3.5 adapter. PyPI 0.0.5 lacks it. MTP is left out
# because vLLM cannot build the draft model from a local GGUF path.
VLLM_GGUF_PLUGIN_REF=e2b8ad532b8b
if [[ "$ENGINE" == vllm ]]; then
  IMAGE="$VLLM_IMAGE"
  HF_FILE="$VLLM_HF_FILE"
  TEMPLATE_NAME="vast-coder-vllm-ssh"
fi
